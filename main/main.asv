% =========================================================================
% EMERGENCY TAKEOVER SYSTEM - 3D BASELINE KINEMATIC (V2.0)
% =========================================================================
clear; close all; clc;
disp('Initializing 3D baseline environment...');

[scenario, tempVar] = env_sim();
% Safely extract the scenario object
if isa(tempVar, 'drivingScenario')
    scenario = tempVar;
end

% Extract the ego vehicle directly from the scenario's memory array
egoVehicle = scenario.Actors(1);
% Force simulation to run for exactly 15 seconds to prevent early exit
scenario.StopTime = 15;
sim_sample_rate = 1 / scenario.SampleTime;

% 2. CREATE THE NAV TOOLBOX TRAJECTORY (THE BRAIN)
% Define points for a simple straight line
waypoints = [0 0 0; 50 0 0; 100 0 0; 150 0 0; 200 0 0];
speed = 15; % Constant speed in m/s
% Calculate Time of Arrival for each point
distances = [0; 50; 100; 150; 200];
toa = distances / speed;
% Create the standalone trajectory generator to calculate physics in the background
planner = waypointTrajectory(waypoints, toa, 'SampleRate', sim_sample_rate);

% 3. 3D VISUALIZATION SETUP
% Create a clean, large figure window for the 3D render
% Create a 3D chase camera view attached to the ego vehicle
chasePlot(egoVehicle, 'Centerline', 'on');

% 4. MAIN SIMULATION LOOP
disp('Starting simple driving loop...');

% Loop until the scenario reaches its end time
while advance(scenario)
    
    % --- KINEMATIC OVERRIDE ---
    % Ask the 'Brain' (planner) for the coordinates at this exact fraction of a second
    if ~isDone(planner)
        [pos, orient, vel] = planner();
        
        % Safety check: Only apply coordinates if they are valid numbers
        if all(isfinite(pos))
            % Manually push the coordinates to the car in the Driving Scenario
            egoVehicle.Position = pos;
            egoVehicle.Velocity = vel;
            
            % Convert quaternion orientation to Euler angles (Yaw, Pitch, Roll)
            angles = eulerd(orient, 'ZYX', 'frame');
            egoVehicle.Yaw = angles(1);
        end
    end
    
    % Force the graphics engine to render the frame at a limited rate
    drawnow limitrate;
    
end

disp('Baseline simulation finished.');